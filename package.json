{
  "name": "@daasavaani/library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tools/publisher.test.ts tools/source-import.test.ts tools/lyric-source.test.ts tools/lyric-publisher.test.ts tools/verse-proposals.test.ts",
    "build": "npm run typecheck",
    "check": "npm run build && npm test && npm run sources:validate && npm run verses:validate",
    "verses:propose": "tsx tools/verse-proposals.ts --generate",
    "verses:validate": "tsx tools/verse-proposals.ts --validate",
    "sources:import": "tsx tools/source-import.ts --import",
    "sources:retry-footers": "tsx tools/source-import.ts --retry-credit-footers",
    "sources:validate": "tsx tools/source-import.ts --validate",
    "publish:demo": "tsx tools/publisher.ts --fixtures",
    "publish:lyrics": "tsx tools/lyric-publisher.ts"
  },
  "dependencies": {
    "ajv": "8.20.0", "yaml": "2.9.1", "unified": "11.0.5",
    "remark-parse": "11.0.0", "remark-frontmatter": "5.0.0"
  },
  "devDependencies": { "@types/node": "22.20.4", "tsx": "4.20.6", "typescript": "5.9.3" }
}
