{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "siteDirectory", "maxHostedBytes", "maxUtilizationPercent"],
  "properties": {
    "formatVersion": { "const": 1 },
    "siteDirectory": { "type": "string", "pattern": "^dist/[a-zA-Z0-9][a-zA-Z0-9/_-]*$" },
    "maxHostedBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "maxUtilizationPercent": { "type": "integer", "minimum": 1, "maximum": 100 }
  }
}
