{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "sourceDirectory", "outputDirectory", "maxSourceFileBytes", "maxTotalSourceBytes", "reviewHoldReason", "creditFooter"],
  "properties": {
    "formatVersion": { "const": 1 },
    "sourceDirectory": { "type": "string", "minLength": 1 },
    "outputDirectory": { "type": "string", "minLength": 1 },
    "maxSourceFileBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "maxTotalSourceBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "reviewHoldReason": { "type": "string", "minLength": 1 },
    "creditFooter": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "primaryLabel", "companionLabel", "additionalLabels"],
      "properties": {
        "enabled": { "type": "boolean" },
        "primaryLabel": { "$ref": "#/$defs/label" },
        "companionLabel": { "$ref": "#/$defs/label" },
        "primaryLabelAliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/label" } },
        "companionLabelAliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/label" } },
        "additionalLabels": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/label" } }
      }
    }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "pattern": "^[^:\\s]+$" }
  }
}
