{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2024"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["tools/**/*.ts", "shared/types/**/*.ts"]
}
